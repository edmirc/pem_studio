# Copie este arquivo para .env (cp env.exemplo .env) e preencha. O .env NUNCA deve ir para o Git.

# Gere uma chave nova com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=0

# Endereços pelos quais o sistema é acessado (separados por vírgula)
DJANGO_ALLOWED_HOSTS=192.168.3.190,100.116.208.105,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.3.190,http://192.168.3.190:81,http://192.168.3.190:8001,http://100.116.208.105,http://100.116.208.105:81,http://100.116.208.105:8001

# Banco MySQL. DB_HOST = nome do container do MySQL (docker ps)
DB_NAME=pem_studio
DB_USER=remoto
DB_PASSWORD=
DB_HOST=mysql
DB_PORT=3306

# Porta do servidor onde o sistema fica disponível
PORTA=8001
# Rede Docker compartilhada com o container do MySQL
REDE_BANCO=pem-rede

TIME_ZONE=America/Cuiaba

# Pasta onde ficam as fotos e arquivos das solicitações (HD externo)
PASTA_IMAGENS=/mnt/hd4t/imagens_pem_studio
